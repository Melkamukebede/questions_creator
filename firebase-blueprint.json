{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "grade": { "type": "string", "maxLength": 32 },
        "stream": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 128 },
        "school": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 128 },
        "isVerifiedTeacher": { "type": "boolean" },
        "isPaid": { "type": "boolean" },
        "region": { "type": "string", "maxLength": 64 },
        "targetExamYear": { "type": "string", "maxLength": 32 },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "isRegistered": { "type": "boolean" },
        "firstRegisteredEmail": { "type": "string", "maxLength": 256 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam data containing questions and nested metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "catalogId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "enum": ["official", "created"] },
        "createdType": { "type": "string", "enum": ["teacher", "student_draft"] },
        "school": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 128 },
        "examYear": { "type": "string", "maxLength": 64 },
        "grade": { "type": "string", "maxLength": 32 },
        "subject": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "object" },
        "questions": { "type": "array" },
        "questionCount": { "type": "number" },
        "difficulty": { "type": "string", "maxLength": 64 },
        "sourceType": { "type": "string", "maxLength": 64 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "userId", "questions"]
    },
    "Question": {
      "title": "Question",
      "description": "Modular question item in the centralized question bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 4000 },
        "options": { "type": "array" },
        "correct": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "imageCaption": { "type": "string", "maxLength": 512 },
        "optionImages": { "type": "array" },
        "tableMarkdown": { "type": "string", "maxLength": 4000 },
        "grade": { "type": "string", "maxLength": 32 },
        "stream": { "type": "string", "maxLength": 64 },
        "isPublic": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "uploadedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "examId", "text", "options", "correct"]
    },
    "UserAttempt": {
      "title": "UserAttempt",
      "description": "Decoupled student practice attempt performance and question review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpent": { "type": "number" },
        "answers": { "type": "array" },
        "subjectType": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "examId", "userId", "score", "total"]
    },
    "Result": {
      "title": "Result",
      "description": "Exam test attempt outcome and question review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpent": { "type": "number" },
        "answers": { "type": "array" },
        "subjectType": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "examId", "userId", "score", "total", "percentage"]
    },
    "StudyReminder": {
      "title": "StudyReminder",
      "description": "User notification reminder preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "time": { "type": "string", "maxLength": 16 },
        "enabled": { "type": "boolean" },
        "days": { "type": "array" }
      },
      "required": ["id", "userId", "enabled"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Student premium subscription record for Ethiopian Birr payments (Chapa, Telebirr, CBE)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "planDuration": { "type": "string", "enum": ["1day", "1week", "1month", "6months"] },
        "amountETB": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["chapa", "telebirr", "cbe", "abyssinia"] },
        "transactionReference": { "type": "string", "maxLength": 128 },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "rejected", "expired"] },
        "startDate": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "planDuration", "amountETB", "paymentMethod", "transactionReference", "paymentStatus", "createdAt"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Archived administrative email notification log for student payments and teacher registrations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["student_payment", "teacher_registration", "test"] },
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 256 },
        "details": { "type": "object" },
        "actionUrl": { "type": "string", "maxLength": 512 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "clientTimestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["type", "recipientEmail", "subject"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Administrator alert email destination, notification preferences, and one-time Supabase link settings",
      "type": "object",
      "properties": {
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "notifyOnStudentPayment": { "type": "boolean" },
        "notifyOnTeacherRegistration": { "type": "boolean" },
        "supabaseUrl": { "type": "string", "maxLength": 512 },
        "supabaseAnonKey": { "type": "string", "maxLength": 1024 },
        "bucketName": { "type": "string", "maxLength": 128 },
        "isConfigured": { "type": "boolean" },
        "linkedBy": { "type": "string", "maxLength": 256 },
        "linkedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profile information of registered users"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exam documents created by users or templates"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Modular question items in the central question bank"
    },
    "/results/{resultId}": {
      "schema": "Result",
      "description": "Legacy exam completion records and question answer histories"
    },
    "/user_attempts/{attemptId}": {
      "schema": "UserAttempt",
      "description": "Decoupled student practice attempt performance metrics and review"
    },
    "/reminders/{reminderId}": {
      "schema": "StudyReminder",
      "description": "Study notification alerts and schedules"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Premium student subscription and payment transaction logs"
    },
    "/admin_notifications/{notificationId}": {
      "schema": "AdminNotification",
      "description": "Administrative alert log and audit history"
    },
    "/admin_settings/{settingId}": {
      "schema": "AdminSettings",
      "description": "Configurable administrator notification email recipient and delivery toggles"
    }
  }
}
