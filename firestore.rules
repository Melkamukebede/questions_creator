rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'melkamukebede11@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Exams Collection (Cloud Database Storage)
    match /exams/{examId} {
      allow get, list: if true;
      allow create: if isSignedIn() || (
        request.resource.data.isPublic == true &&
        request.resource.data.id == examId
      );
      allow update: if (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          resource.data.authorEmail == request.auth.token.email ||
          isAdmin()
        )
      ) || (
        resource.data.isPublic == true &&
        request.resource.data.isPublic == true &&
        request.resource.data.id == examId
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorEmail == request.auth.token.email ||
        resource.data.userId == 'guest' ||
        isAdmin()
      );
    }

    // Questions Bank Collection (Individual Question Storage)
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() || request.resource.data.isPublic == true;
      allow update: if (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid ||
          isAdmin()
        )
      ) || (
        resource.data.isPublic == true &&
        request.resource.data.isPublic == true
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // User Attempts Collection (Decoupled student practice metrics)
    match /user_attempts/{attemptId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Results Collection (Legacy)
    match /results/{resultId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reminders Collection
    match /reminders/{reminderId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Test collection for initial connectivity test
    match /test/{docId} {
      allow read: if true;
    }

    // Subscriptions Collection (Premium Ethiopian Birr Payment Records)
    // Students can read their own subscriptions and submit new payment requests.
    // Admin can view, verify, and manage all subscriptions.
    match /subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admin Notifications Archive
    // Authenticated users can write notification audit events; only admin can view/manage
    match /admin_notifications/{notificationId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if isAdmin();
    }

    // One-Time Linked Supabase Configuration (Public read so all devices auto-connect; Admin-only write)
    match /admin_settings/supabase_config {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Admin Settings (e.g. notifications recipient & alert toggles)
    match /admin_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
